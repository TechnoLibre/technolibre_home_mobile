<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_demo_counter_form" model="ir.ui.view">
    <field name="name">demo.counter.form</field>
    <field name="model">demo.counter</field>
    <field name="arch" type="xml">
      <form string="Compteur">
        <sheet>
          <group>
            <field name="name"/>
            <field name="value"/>
            <field name="step"/>
            <field name="doubled"/>
          </group>
          <widget name="demo_counter"/>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
